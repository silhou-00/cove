<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ runtime permission for local reminders (§7). Requested
         contextually at first reminder setup, not at app launch — see
         NotificationService. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Exact-time reminder delivery (§7) — without this, Android (and
         OEM battery management on top of it, e.g. MIUI) is free to
         delay or drop an "inexact" scheduled notification by an
         unbounded amount, which defeats the point of a "remind me before
         X" feature. Requires user consent via a system settings screen
         on Android 12+ (13+ especially) — requested contextually, same
         as POST_NOTIFICATIONS, see NotificationService. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Lets ScheduledNotificationBootReceiver re-register reminders that
         were still pending when the device rebooted (AlarmManager alarms
         don't survive a reboot on their own). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- App lock (§12) biometric prompt — local_auth requirement. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>
    <!-- Google Drive/Calendar API calls (§8/§9). Declared explicitly here
         rather than relying on it merging in transitively from
         google_sign_in_android's own plugin manifest. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- allowBackup=false (§12/§13): Android's Auto Backup default-includes
         this app's private storage, which holds the salted PIN hash and
         Google connection state — that shouldn't be eligible for cloud
         backup or `adb backup` extraction. -->
    <application
        android:label="Cove"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <!-- Anchors ic_notification.xml as a reachable resource for R8's
             resource shrinker (§13, isShrinkResources) — flutter_local_
             notifications only references it by string name from Dart,
             which the shrinker can't see, so it gets stripped without a
             real manifest reference like this one. Not read by any code;
             its only job is to keep the drawable in the built APK. -->
        <meta-data
            android:name="com.silhou.cove.NOTIFICATION_ICON_ANCHOR"
            android:resource="@drawable/ic_notification" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Up Next home screen widget (§6). Tap-through and pin-request
             both go through the home_widget plugin's own launch-intent
             mechanism (HomeWidgetLaunchIntent), not an OS-level cove://
             intent-filter — see documents/documentation.md. -->
        <receiver
            android:name=".UpNextWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_next_widget_info"/>
        </receiver>

        <!-- Agenda + Areas home screen widgets (§6, V2). Same
             HomeWidgetLaunchIntent tap-through mechanism as Up Next. -->
        <receiver
            android:name=".AgendaWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget_info"/>
        </receiver>
        <receiver
            android:name=".AreasWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/areas_widget_info"/>
        </receiver>

        <!-- flutter_local_notifications (§7) — as of v17+, the plugin no
             longer bundles these receiver declarations in its own AAR
             manifest; the app must declare them itself or every scheduled
             alarm fires into the void (AlarmManager delivers the broadcast,
             finds no matching component, and silently no-ops — no
             exception, no channel, nothing). -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
