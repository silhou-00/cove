<?xml version="1.0" encoding="utf-8"?>
<!-- Areas widget (§6/§17) — populated in AreasWidgetProvider.kt. Four
     side-by-side columns (mini bar + "NAME %" label), matching the design
     handoff's "05 — Home screen widgets" mockup, not stacked full-width
     rows — plus an "LV n" level badge in the header corner (the design's
     own rule: "Level marker sits in the Areas widget corner only — no
     fifth widget"). Per-area colored fill is drawn as a small bitmap
     (AreasWidgetProvider.makeBarBitmap) rather than a real ProgressBar,
     since dynamically tinting/proportioning a ProgressBar's fill through
     RemoteViews needs API 31+; a plain bitmap works on every API level
     this app supports. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AREAS · THIS WEEK"
            android:textSize="11sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/ibm_plex_mono_medium"
            android:textColor="#8A8175"/>
        <TextView
            android:id="@+id/header_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="@font/ibm_plex_mono_medium"
            android:textColor="#1B1917"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="10dp"/>

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No areas yet."
        android:textSize="14sp"
        android:fontFamily="@font/ibm_plex_sans"
        android:textColor="#6B6459"
        android:visibility="gone"/>

    <!-- Populated dynamically in AreasWidgetProvider.kt via addView, one
         widget_areas_column.xml per area — not a fixed set of slots, so
         the row scales (each column's own layout_weight shrinks
         proportionally) whether there are 2 areas or 8, instead of
         silently dropping anything past a hardcoded count. -->
    <LinearLayout
        android:id="@+id/columns_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"/>

</LinearLayout>
