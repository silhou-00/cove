<?xml version="1.0" encoding="utf-8"?>
<!-- Agenda widget (§6) — populated in AgendaWidgetProvider.kt. 5 row slots,
     since a 4×3 grid realistically fits about that many. Text sizes are
     bumped up from the design mockup's raw px values — those assume the
     in-app Flutter screens' `context.s()` scaling (up to 1.35x), which
     doesn't exist for native RemoteViews, so using the mockup's numbers
     unscaled read noticeably smaller here than the equivalent in-app text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/header_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:letterSpacing="0.16"
            android:fontFamily="@font/ibm_plex_mono_medium"
            android:textColor="#8A8175"/>
        <TextView
            android:id="@+id/header_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="@font/ibm_plex_mono_regular"
            android:textColor="#6B6459"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="8dp"/>

    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nothing today."
        android:textSize="14sp"
        android:fontFamily="@font/ibm_plex_sans"
        android:textColor="#6B6459"
        android:visibility="gone"/>

    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/row1_time" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="11.5sp" android:fontFamily="@font/ibm_plex_mono_regular" android:textColor="#6B6459"/>
        <LinearLayout android:id="@+id/row1_bar" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:background="#8A8175"/>
        <TextView android:id="@+id/row1_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="14.5sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="#1B1917" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/row2_time" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="11.5sp" android:fontFamily="@font/ibm_plex_mono_regular" android:textColor="#6B6459"/>
        <LinearLayout android:id="@+id/row2_bar" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:background="#8A8175"/>
        <TextView android:id="@+id/row2_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="14.5sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="#1B1917" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/row3_time" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="11.5sp" android:fontFamily="@font/ibm_plex_mono_regular" android:textColor="#6B6459"/>
        <LinearLayout android:id="@+id/row3_bar" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:background="#8A8175"/>
        <TextView android:id="@+id/row3_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="14.5sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="#1B1917" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/row4_time" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="11.5sp" android:fontFamily="@font/ibm_plex_mono_regular" android:textColor="#6B6459"/>
        <LinearLayout android:id="@+id/row4_bar" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:background="#8A8175"/>
        <TextView android:id="@+id/row4_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="14.5sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="#1B1917" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/row5_time" android:layout_width="40dp" android:layout_height="wrap_content" android:textSize="11.5sp" android:fontFamily="@font/ibm_plex_mono_regular" android:textColor="#6B6459"/>
        <LinearLayout android:id="@+id/row5_bar" android:layout_width="2dp" android:layout_height="16dp" android:layout_marginStart="8dp" android:background="#8A8175"/>
        <TextView android:id="@+id/row5_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:textSize="14.5sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="#1B1917" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>

</LinearLayout>
